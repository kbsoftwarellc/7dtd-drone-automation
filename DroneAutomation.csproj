<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build: DOTNET_ROOT=$HOME/.dotnet ~/.dotnet/dotnet build -c Release -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>DroneAutomation</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <EnableDefaultCompileItems>true</EnableDefaultCompileItems>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>

    <!-- Where the game is installed. Override for a different machine or install without editing
         this file, either way round:
             GAME_DIR="/path/to/7 Days To Die" dotnet build -c Release
             dotnet build -c Release -p:GameDir="/path/to/7 Days To Die"
         The two fallbacks are the usual native and Flatpak/Steam library paths. -->
    <GameDir Condition="'$(GameDir)' == '' AND '$(GAME_DIR)' != ''">$(GAME_DIR)</GameDir>
    <GameDir Condition="'$(GameDir)' == '' AND Exists('$(HOME)/.local/share/Steam/steamapps/common/7 Days To Die')">$(HOME)/.local/share/Steam/steamapps/common/7 Days To Die</GameDir>
    <GameDir Condition="'$(GameDir)' == ''">$(HOME)/.steam/steam/steamapps/common/7 Days To Die</GameDir>

    <GameManaged>$(GameDir)/7DaysToDie_Data/Managed</GameManaged>
    <ModDeploy>$(GameDir)/Mods/DroneAutomation</ModDeploy>
  </PropertyGroup>

  <ItemGroup>
    <!-- Harmony patches EntityDrone.OnUpdateEntity to drive every module. We compile against the
         game's own Harmony (TFP ships it in Mods/0_TFP_Harmony, loaded before every other mod), so
         we neither bundle nor ship 0Harmony.dll — matching the exact runtime version. Private=false
         keeps it out of our output. -->
    <Reference Include="0Harmony">                 <HintPath>$(GameDir)/Mods/0_TFP_Harmony/0Harmony.dll</HintPath>    <Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp">          <HintPath>$(GameManaged)/Assembly-CSharp.dll</HintPath>          <Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp-firstpass"><HintPath>$(GameManaged)/Assembly-CSharp-firstpass.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="LogLibrary">               <HintPath>$(GameManaged)/LogLibrary.dll</HintPath>               <Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule">   <HintPath>$(GameManaged)/UnityEngine.CoreModule.dll</HintPath>   <Private>false</Private></Reference>
    <Reference Include="UnityEngine">              <HintPath>$(GameManaged)/UnityEngine.dll</HintPath>              <Private>false</Private></Reference>
  </ItemGroup>

  <!-- mod/ = the deployable payload (source of truth for packaging). -->
  <ItemGroup>
    <ModAssets Include="mod/**/*" Exclude="mod/**/*.dll" />
  </ItemGroup>

  <!-- Refresh mod/ with the freshly built DLL. Always safe: no game install needed. -->
  <Target Name="RefreshModPayload" AfterTargets="Build">
    <Copy SourceFiles="$(OutputPath)DroneAutomation.dll" DestinationFolder="mod" SkipUnchangedFiles="false" />
  </Target>

  <!-- Sync into the live game folder. Skipped when the game isn't installed here, so the project
       still builds on a machine that only wants the DLL. -->
  <Target Name="DeployMod" AfterTargets="RefreshModPayload" Condition="Exists('$(GameDir)')">
    <Copy SourceFiles="@(ModAssets)" DestinationFiles="@(ModAssets->'$(ModDeploy)/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="false" />
    <Copy SourceFiles="mod/DroneAutomation.dll" DestinationFolder="$(ModDeploy)" SkipUnchangedFiles="false" />
    <Message Importance="high" Text="Synced mod payload + DLL -> $(ModDeploy)" />
  </Target>
</Project>
