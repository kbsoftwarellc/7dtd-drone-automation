<?xml version="1.0" encoding="UTF-8"?>
<config>
	<!--
	  The switches behind the drone's "Automation modules" talk menu (see dialogs.xml).

	  WHY BUFFS AT ALL. The menu has to change server-side state from a click in a client-side UI,
	  and this mod ships no client DLL. The dialog system's only extensible write is
	  <action type="AddBuff"/> (BaseDialogAction.ActionTypes has exactly six members, and AddBuff is
	  the only one that isn't quest/trader/voice plumbing). So each menu row adds a buff that lives
	  for a tenth of a second, writes one CVar, and expires - the same shape vanilla uses for its
	  triggerInfection / triggerAbrasion test buffs.

	  The round trip is what makes it work without a client mod:
	    - the client's own EntityBuffs.AddBuff runs the effect locally, so the menu row flips the
	      instant you click it;
	    - AddBuff net-syncs, and NetPackageAddRemoveBuff.ProcessPackage re-applies the buff on the
	      server, so the server runs the same ModifyCVar and DronePatch reads the result.
	  Nothing is polled and no custom NetPackage exists, so a vanilla client cannot be kicked over it.

	  POLARITY IS DELIBERATE. The CVar means DISABLED, not enabled. EntityBuffs.GetCustomVar returns
	  0 for a name it has never seen and EntityBuffs.Write skips any CVar sitting at 0, so "absent"
	  and "zero" have to be the safe state - otherwise every existing player's modules would go dark
	  on update, and switching one back on would leave nothing on disk to prove it.

	  OPERATION IS ALWAYS "set". On a dedicated server a buff applied to a player can fire both
	  onSelfBuffStart and onSelfBuffStack for one application, so any relative op (add/subtract)
	  applies twice. "set" is idempotent, so the echo cannot corrupt the flag.
	-->
	<append xpath="/buffs">

		<!-- Auto-Loot -->
		<buff name="buffDaLootDisable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daLootOff" operation="set" value="1"/>
			</effect_group>
		</buff>
		<buff name="buffDaLootEnable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daLootOff" operation="set" value="0"/>
			</effect_group>
		</buff>

		<!-- Auto-Salvage -->
		<buff name="buffDaSalvageDisable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daSalvageOff" operation="set" value="1"/>
			</effect_group>
		</buff>
		<buff name="buffDaSalvageEnable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daSalvageOff" operation="set" value="0"/>
			</effect_group>
		</buff>

		<!-- Auto-Harvest -->
		<buff name="buffDaHarvestDisable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daHarvestOff" operation="set" value="1"/>
			</effect_group>
		</buff>
		<buff name="buffDaHarvestEnable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daHarvestOff" operation="set" value="0"/>
			</effect_group>
		</buff>

		<!-- Auto-Repair -->
		<buff name="buffDaRepairDisable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daRepairOff" operation="set" value="1"/>
			</effect_group>
		</buff>
		<buff name="buffDaRepairEnable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daRepairOff" operation="set" value="0"/>
			</effect_group>
		</buff>

		<!-- Auto-Plant -->
		<buff name="buffDaPlantDisable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daPlantOff" operation="set" value="1"/>
			</effect_group>
		</buff>
		<buff name="buffDaPlantEnable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daPlantOff" operation="set" value="0"/>
			</effect_group>
		</buff>

		<!-- Auto-Defense -->
		<buff name="buffDaDefenseDisable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daDefenseOff" operation="set" value="1"/>
			</effect_group>
		</buff>
		<buff name="buffDaDefenseEnable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daDefenseOff" operation="set" value="0"/>
			</effect_group>
		</buff>

		<!-- One row that clears every switch. A player who has turned several modules off and lost
		     track of which needs one click to get back to stock behaviour, and it doubles as the
		     recovery path if a switch is ever left set by a mod update. -->
		<buff name="buffDaAllEnable" hidden="true">
			<duration value=".1"/>
			<effect_group>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daLootOff"    operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daSalvageOff" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daHarvestOff" operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daRepairOff"  operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daPlantOff"   operation="set" value="0"/>
				<triggered_effect trigger="onSelfBuffStart" action="ModifyCVar" cvar="daDefenseOff" operation="set" value="0"/>
			</effect_group>
		</buff>

	</append>
</config>
