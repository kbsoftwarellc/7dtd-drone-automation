<?xml version="1.0" encoding="UTF-8"?>
<config>
	<append xpath="/item_modifiers">
		<!-- Auto-Loot: the drone opens bags/containers and grabs dropped items. -->
		<item_modifier name="modRoboticDroneAutoLootMod" installable_tags="drone" modifier_tags="droneAutoLoot" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="60,220,60"/>
			<property name="DescriptionKey" value="modRoboticDroneAutoLootModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAutoLootModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<!-- Quality 1-6 bar. Crafting always makes Q1; loot/trader roll higher. The DLL reads
			     this quality and scales the module's reach + speed (see QualityScale). -->
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
		</item_modifier>

		<!-- Auto-Salvage: the drone wrenches nearby unclaimed salvageable blocks into its bag. -->
		<item_modifier name="modRoboticDroneAutoSalvageMod" installable_tags="drone" modifier_tags="droneAutoSalvage" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="230,150,40"/>
			<property name="DescriptionKey" value="modRoboticDroneAutoSalvageModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAutoSalvageModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
		</item_modifier>

		<!-- Auto-Harvest: the drone reaps and replants grown crops in your land claim, into its bag. -->
		<item_modifier name="modRoboticDroneAutoHarvestMod" installable_tags="drone" modifier_tags="droneAutoHarvest" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="120,200,90"/>
			<property name="DescriptionKey" value="modRoboticDroneAutoHarvestModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAutoHarvestModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
		</item_modifier>

		<!-- Auto-Repair: the drone repairs damaged blocks in your land claim, paying from its bag. -->
		<item_modifier name="modRoboticDroneAutoRepairMod" installable_tags="drone" modifier_tags="droneAutoRepair" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="70,170,230"/>
			<property name="DescriptionKey" value="modRoboticDroneAutoRepairModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAutoRepairModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
		</item_modifier>

		<!-- Auto-Plant: the drone sows young crops from its bag onto empty farm plots in your claim. -->
		<item_modifier name="modRoboticDroneAutoPlantMod" installable_tags="drone" modifier_tags="droneAutoPlant" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="220,200,60"/>
			<property name="DescriptionKey" value="modRoboticDroneAutoPlantModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAutoPlantModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
		</item_modifier>

		<!-- Overclock (enhancement): no automation of its own; speeds up every other module. -->
		<item_modifier name="modRoboticDroneOverclockMod" installable_tags="drone" modifier_tags="droneOverclock" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="200,80,220"/>
			<property name="DescriptionKey" value="modRoboticDroneOverclockModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneOverclockModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
		</item_modifier>

		<!-- Wide-Band Antenna (enhancement): no automation of its own; widens every module's reach. -->
		<item_modifier name="modRoboticDroneAntennaMod" installable_tags="drone" modifier_tags="droneAntenna" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="60,200,220"/>
			<property name="DescriptionKey" value="modRoboticDroneAntennaModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAntennaModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
		</item_modifier>
	</append>
</config>
