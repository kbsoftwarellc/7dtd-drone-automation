<?xml version="1.0" encoding="UTF-8"?>
<config>
	<append xpath="/item_modifiers">
		<!-- Auto-Loot: the drone opens bags/containers and grabs dropped items. -->
		<item_modifier name="modRoboticDroneAutoLootMod" installable_tags="drone" modifier_tags="droneAutoLoot" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="60,220,60"/>
			<property name="DescriptionKey" value="modRoboticDroneAutoLootModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAutoLootModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<!-- Quality 1-6 bar. Crafted quality follows the Robotics crafting skill (progression.xml);
			     traders roll their own off TraderStageTemplate. Loot is NOT a source - vanilla V3 has
			     every modRoboticDrone*Mod commented out of loot.xml, so only schematics drop. The DLL
			     reads this quality and scales the module's reach + speed (see QualityScale). -->
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
			<!-- Listed in the creative menu. modGeneralMaster sets CreativeMode="None", so without
			     this an item modifier is filtered out of it entirely (ItemClass.GetItemsAndBlocks
			     skips None unconditionally - the show-hidden toggle does NOT override it). -->
			<property name="CreativeMode" value="Player"/>

			<!-- REQUIRED for quality to be ROLLED, not merely displayed. ItemClass.HasQuality is
			     `Effects.IsOwnerTiered()`, and every generation path - the creative menu
			     (ItemClass.CreateItemStacks) and trader stock alike - goes through
			     ItemValue(type, minQ, maxQ), which assigns Quality ONLY when that is true. With no
			     effect_group at all these modules came out Quality 0, which the creative menu renders
			     as "*" (XUiC_ItemStack falls back to "*" for a mod at quality 0) and which the DLL
			     then clamps back up to Quality 1 - so every generated module was silently the weakest
			     tier. An effect_group is tiered unless it says tiered="false", so this one group is
			     enough. It carries a display_value and NO passive_effect on purpose: the reach and
			     speed scaling lives in the DLL (QualityScale), not in the item's own effects. -->
			<effect_group>
				<display_value name="dDroneModuleLevel" value="1,2,3,4,5,6" tier="1,2,3,4,5,6"/>
			</effect_group>
		</item_modifier>

		<!-- Auto-Salvage: the drone wrenches nearby unclaimed salvageable blocks into its bag. -->
		<item_modifier name="modRoboticDroneAutoSalvageMod" installable_tags="drone" modifier_tags="droneAutoSalvage" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="230,150,40"/>
			<property name="DescriptionKey" value="modRoboticDroneAutoSalvageModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAutoSalvageModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
			<!-- See the Auto-Loot block above for why both of these are needed: CreativeMode because
			     modGeneralMaster hides modifiers from the creative menu, and a TIERED effect_group
			     because ItemClass.HasQuality is Effects.IsOwnerTiered() and nothing rolls a quality
			     without it. display_value only - the scaling itself lives in the DLL. -->
			<property name="CreativeMode" value="Player"/>
			<effect_group>
				<display_value name="dDroneModuleLevel" value="1,2,3,4,5,6" tier="1,2,3,4,5,6"/>
			</effect_group>
		</item_modifier>

		<!-- Auto-Harvest: the drone reaps and replants grown crops in your land claim, into its bag. -->
		<item_modifier name="modRoboticDroneAutoHarvestMod" installable_tags="drone" modifier_tags="droneAutoHarvest" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="120,200,90"/>
			<property name="DescriptionKey" value="modRoboticDroneAutoHarvestModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAutoHarvestModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
			<!-- See the Auto-Loot block above for why both of these are needed: CreativeMode because
			     modGeneralMaster hides modifiers from the creative menu, and a TIERED effect_group
			     because ItemClass.HasQuality is Effects.IsOwnerTiered() and nothing rolls a quality
			     without it. display_value only - the scaling itself lives in the DLL. -->
			<property name="CreativeMode" value="Player"/>
			<effect_group>
				<display_value name="dDroneModuleLevel" value="1,2,3,4,5,6" tier="1,2,3,4,5,6"/>
			</effect_group>
		</item_modifier>

		<!-- Auto-Repair: the drone repairs damaged blocks in your land claim, paying from its bag. -->
		<item_modifier name="modRoboticDroneAutoRepairMod" installable_tags="drone" modifier_tags="droneAutoRepair" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="70,170,230"/>
			<property name="DescriptionKey" value="modRoboticDroneAutoRepairModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAutoRepairModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
			<!-- See the Auto-Loot block above for why both of these are needed: CreativeMode because
			     modGeneralMaster hides modifiers from the creative menu, and a TIERED effect_group
			     because ItemClass.HasQuality is Effects.IsOwnerTiered() and nothing rolls a quality
			     without it. display_value only - the scaling itself lives in the DLL. -->
			<property name="CreativeMode" value="Player"/>
			<effect_group>
				<display_value name="dDroneModuleLevel" value="1,2,3,4,5,6" tier="1,2,3,4,5,6"/>
			</effect_group>
		</item_modifier>

		<!-- Auto-Plant: the drone sows young crops from its bag onto empty farm plots in your claim. -->
		<item_modifier name="modRoboticDroneAutoPlantMod" installable_tags="drone" modifier_tags="droneAutoPlant" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="220,200,60"/>
			<property name="DescriptionKey" value="modRoboticDroneAutoPlantModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAutoPlantModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
			<!-- See the Auto-Loot block above for why both of these are needed: CreativeMode because
			     modGeneralMaster hides modifiers from the creative menu, and a TIERED effect_group
			     because ItemClass.HasQuality is Effects.IsOwnerTiered() and nothing rolls a quality
			     without it. display_value only - the scaling itself lives in the DLL. -->
			<property name="CreativeMode" value="Player"/>
			<effect_group>
				<display_value name="dDroneModuleLevel" value="1,2,3,4,5,6" tier="1,2,3,4,5,6"/>
			</effect_group>
		</item_modifier>

		<!-- Auto-Defense: the drone fires its own (vanilla-dormant) machine gun at nearby hostiles. -->
		<item_modifier name="modRoboticDroneAutoDefenseMod" installable_tags="drone" modifier_tags="droneAutoDefense" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="220,60,50"/>
			<property name="DescriptionKey" value="modRoboticDroneAutoDefenseModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAutoDefenseModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
			<property name="CreativeMode" value="Player"/>
			<!-- Flat per-shot damage bonus. The junk drone's gun does 5 base damage (from
			     entityJunkDrone's EntityDamage), and the drone's own firing code sums this passive off
			     the installed mod through EffectManager, giving 15/shot. Kept flat on purpose: unlike a
			     base weapon, a MOD's level= tiers don't reliably track the mod's own quality, so the
			     DLL scales what it can guarantee - fire rate and reach - by the module's Quality. -->
			<effect_group tiered="false">
				<passive_effect name="EntityDamage" operation="base_add" value="10"/>
			</effect_group>
			<!-- The damage group above is deliberately tiered="false", which also meant this module
			     had NO tiered group and so no rollable quality. A second, tiered group fixes that
			     without touching the flat damage: IsOwnerTiered() is true if ANY group is tiered. -->
			<effect_group>
				<display_value name="dDroneModuleLevel" value="1,2,3,4,5,6" tier="1,2,3,4,5,6"/>
			</effect_group>
		</item_modifier>

		<!-- Overclock (enhancement): no automation of its own; speeds up every other module. -->
		<item_modifier name="modRoboticDroneOverclockMod" installable_tags="drone" modifier_tags="droneOverclock" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="200,80,220"/>
			<property name="DescriptionKey" value="modRoboticDroneOverclockModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneOverclockModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
			<!-- See the Auto-Loot block above for why both of these are needed: CreativeMode because
			     modGeneralMaster hides modifiers from the creative menu, and a TIERED effect_group
			     because ItemClass.HasQuality is Effects.IsOwnerTiered() and nothing rolls a quality
			     without it. display_value only - the scaling itself lives in the DLL. -->
			<property name="CreativeMode" value="Player"/>
			<effect_group>
				<display_value name="dDroneModuleLevel" value="1,2,3,4,5,6" tier="1,2,3,4,5,6"/>
			</effect_group>
		</item_modifier>

		<!-- Wide-Band Antenna (enhancement): no automation of its own; widens every module's reach. -->
		<item_modifier name="modRoboticDroneAntennaMod" installable_tags="drone" modifier_tags="droneAntenna" type="attachment">
			<property name="Extends" value="modGeneralMaster" param1="CustomIcon"/>
			<property name="CustomIcon" value="modRoboticDroneCargoMod"/>
			<property name="CustomIconTint" value="60,200,220"/>
			<property name="DescriptionKey" value="modRoboticDroneAntennaModDesc"/>
			<property name="UnlockedBy" value="modRoboticDroneAntennaModSchematic"/>
			<property name="TraderStageTemplate" value="modsTier3"/>
			<property name="MaxModsAllowed" value="4"/>
			<property name="ShowQuality" value="true"/>
			<property name="QualityMin" value="1"/>
			<!-- See the Auto-Loot block above for why both of these are needed: CreativeMode because
			     modGeneralMaster hides modifiers from the creative menu, and a TIERED effect_group
			     because ItemClass.HasQuality is Effects.IsOwnerTiered() and nothing rolls a quality
			     without it. display_value only - the scaling itself lives in the DLL. -->
			<property name="CreativeMode" value="Player"/>
			<effect_group>
				<display_value name="dDroneModuleLevel" value="1,2,3,4,5,6" tier="1,2,3,4,5,6"/>
			</effect_group>
		</item_modifier>
	</append>
</config>
